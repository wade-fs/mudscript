int exert_sunforce()
{
        object ob=this_object();
        if( !present("sunforce finger",ob) )
        {
          command("say n..ѤҴNAC");
          command("exert sun-finger");
          command("wield finger");
        }
        return 1;
}

int do_answer(string str)
{
        object me=this_player();
        string *answer = ({
        "`Y",
        "hWh",
        "vTH",
        "yMns",
        "Kץɪ",
        "XLGH",
        "@O",
        "L",
        "djyH",
        "@BLɴ",
        "Bs@M",
        "ѷt@Hè",
        "gս"
        });
        if(me->query_temp("answer") < 0);
        else
        {
          if(str == answer[me->query_temp("answer")])
          {
            command("pat "+me->query("id"));
            write("ܦnM" + RANK_D->query_respect(me) + "ǩl, h[VO, "+
            "L饲ରqaoj, bWWߩmC\n");
            command("recruit " + me->query("id") );
            me->set("startroom",environment(me));
            write("..A\\¥, vUA@uOaC\n");
            message_vision("qwwXk, $NYʷ|ޤ@, ]q$NYW_FX....C\n",me);
            me->improve_skill("sunforce",2);
            command("smile "+me->query("id"));
            write("nF, vwN@p@ߪkǻPA, AAAy, שjC\n");
            CHANNEL_D->do_channel(this_object(), "chat",
            sprintf("%sqa@F, Ʊjaॻۦ믫ULC",me->name(1)));
          }
          else
          {
            command("sigh "+me->query("id"));
            write(RANK_D->query_respect(me)+"AǯiӲLF, ]\\Ӧhh~|y, "+
            "UⴤFAӧڧa...\n");
          }
          me->delete_temp("answer");
        }
        return 1;
}

