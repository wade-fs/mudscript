int accept_object(object me, object obj)
{
        if( obj->query("name") == "@ߪkD" )
        {
          command("pat "+getuid(me));
          command("say ӦnF, OhݭUAܡS¤FC");
          if( me->query("family/family_name") == "qa" && !me->query("marks/sun-finger") )
          {
            command("say JMA@eD\\, ګKNDWO۶Ǳ»PAaC");
            write(this_object()->query("name")+"ݵۯDHtm@MC\n\n"+
            "Aıoߤü{ŵMeq, Oty@PѡC\n\n"+
            "[36mAOȹFWFC\n\n"+
            "[1mAǷ|F@ߪkۡuƮ𬰵vC[0m\n\n");
            if( me->query("force") < me->query("max_force") )
              me->set("force",me->query("max_force"));
            me->set("marks/sun-finger",1);
          }
          destruct(obj);
        }
        else if(obj->query("name")=="iLBb" && obj->query("linpo_quest"))
        {
          if(me->query("marks/ask_linpo")!=3){
            write("qݤFݤWFAıo@IγB]SAOB\\"+
                  obj->query("name")+"ӯH!!\n");
            destruct(obj);
          }
          else{
            command("say SANOoD");
            command("think");
            command("hmm");
            command("say pGڨSOܡAoF֤FXAeҰOoǧڳwgйLAF!!\n");
            command("give "+obj->query("id")+" to "+me->query("id"));
            me->set("marks/ask_linpo",4);
            command("say pGAuQiLBؾǷ|ANhqAa!!\n");
          }
        }
        else
        {
        command("? "+getuid(me));
        record="";
        record=getuid(me)+"Fq@"+obj->query("name")+"b"+ctime(time())+"C";
        add_record(record);
        bad_man=getuid(me);
        }
        return 1;
}

void add_record(string arg)
{
        write_file("/u/b/bss/duan_record", arg);
        return ;
}

void die()
{
        object winner = query_temp("last_damage_from");
        int j;
        if(!winner)
        {
          ::die();
        return ;
        }
        if(!wizardp(winner)){
        tell_object(users(),"\n\t[1my[36mѤUXڽ  @J򷳤R\n\t\tӹQ~ͯ  ӤHͤ@K[0m[1mz[0m\n"+
        "\n\t[1mQڬqa, ѩ[33m"+winner->query("name")+"[0;1m\n\ti  [1;31mɤ]  B]  R][0m\n");
        tell_object(users(),"\n\n[36mnѪŵeL@D[5myP[0mC\n\n\t[1;31mu[35m[31m[35m[31m[35mP[31m[35m[31mv[0m\n\n");
        }
    if(userp(winner) && winner->query_temp("not_robot") > 1 )
    {
        if ( winner->query_temp("bless")==1 )
        {
        j=random(-1);
          if( j==7 || j==77 || j== 777 || j==1111 || j==55 || j==555 || j==1000 || j==4000 || j==3333 || j==2222 )
          {
          new("/open/sky/obj2/peace_stone")->move(environment(winner));
          message_vision(HIM + "\nqqWUF@_ǪF!!\n" + NOR,winner);
          write_file("/log/sky/obj2/peace_stone",sprintf("%s(%s) qUFM۩ %s\n",
          winner->name(1),winner->query("id"),ctime(time())));
          }
        }else{
        j=random(-1);
          if( j==5 || j==15 || j== 150 || j==1500 || j==10 || j==100 || j==1000 || j==4000 || j==6666 || j==7777 )
          {
          new("/open/sky/obj2/peace_stone")->move(environment(winner));
          message_vision(HIM + "\nqqWUF@_ǪF!!\n" + NOR,winner);
          write_file("/log/sky/obj2/peace_stone",sprintf("%s(%s) qUFM۩ %s\n",
          winner->name(1),winner->query("id"),ctime(time())));
          }
        }
      }

        :: die();
}

int accept_kill(object who)
{

        who=this_player();
        if(who->query("id")==bad_man)
        {
        record="";
        record=getuid(who)+"iQΧ@kqb"+ctime(time())+"C";
        add_record(record);
        }
        command("unwield all");
        command("wield fan");
        command("kill "+who->query("id"));
        command("exert sun-finger");
        command("perform unarmed.handwriting");
        command("wield finger");
        return 1;
}
int accept_fight(object who)
{
        who=this_player();
        if(who->query("id")==bad_man)
        {
        record="";
        record=getuid(who)+"iQΧ@kqb"+ctime(time())+"C";
        add_record(record);
        }
        command("unwield all");
        command("wield fan");
        command("exert sun-finger");
        fight_ob(who);
        command("perform unarmed.handwriting");
        command("wield finger");
        return 1;
}
int do_title()
{
  object me=this_player();
  if(!me->query("marks/fan-finger")) return 0;
  if(!me->query("make_ok"))
  {
if(me->query("gender")=="k")
{
me->set("title","" + HIY + "r" + NOR + "y" + HIC + "" + NOR + "" + HIC + "F" + NOR + "ҡz");
  me->set("make_ok",1);
tell_object(me,"AAnBnrI...@!!!\n");
}
else
{
me->set("title","" + HIM + "ަ" + NOR + "y" + HIY + "" + NOR + "" + HIY + "F" + NOR + "Zz");
  me->set("make_ok",1);
tell_object(me,"AAnBnrI...@!!!\n");
}
}
else
tell_object(me,"դUwgLtitleFC\n");
  return 1;
}
