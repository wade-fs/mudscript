int do_answer(string str)
{
        object me=this_player();
        string *answer = ({
        "¸·¤¼¸·¤¼©`­Y¦ó",
        "¥h¤é­W¦h",
        "¹ï¼v¦¨¤T¤H",
        "±yµM¨£«n¤s",
        "¬K­·¤£«×¥ÉªùÃö",
        "¦è¥X¶§ÃöµL¬G¤H",
        "¦@¦¹¿OÀë¥ú",
        "¦¹«ëºøºøµLµ´´Á",
        "¤d¥j­·¬y¤Hª«",
        "¤@¨B¦¿´òµLºÉ´Á",
        "¿B°s¤@ªM¯º¬õ¹Ð",
        "ÅÑÅÑ·t¯º¥@¤HÃ¨",
        "¯«¾÷§®ºâÆg¥Õ½¬"
        });
        if(me->query_temp("answer") < 0);
        else
        {
          if(str == answer[me->query_temp("answer")])
          {
            command("pat "+me->query("id"));
            write("«Ü¦n¡M" + RANK_D->query_respect(me) + "ªº¤å¾Ç©³¤l¤£¿ù, ¦h¥[§V¤O, "+
            "¥L¤é¥²¯à¬°¬q®aµo´­¥ú¤j, ¦b¦¿´ò¤W´­¦W¥ß©m¡C\n");
            command("recruit " + me->query("id") );
            me->set("startroom",environment(me));
            write("¶â..§Aªº¤º¥\\¤£°÷¯Â¥¿, Åý¬°®vªº§U§A¤@Áu¤§¤O§a¡C\n");
            message_vision("¬q¶³½w½wªº¦ù¥X¥k¤â, ©¹$NÀY³»ªº¦Ê·|¥Þ¤@«ö, µ·µ·ªº»]®ð±q$NªºÀY¤W«_¤F¥X¨Ó....¡C\n",me);
            me->improve_skill("sunforce",2);
            command("smile "+me->query("id"));
            write("¦n¤F, ¬°®v¤w±N¤@¤p³¡¥÷ªº¤@¶§¤ßªk¶Ç»P§A, ±æ§A¯à¦A±µ¦AÀy, ²×©ó¤j¦¨¡C\n");
            CHANNEL_D->do_channel(this_object(), "chat",
            sprintf("%s¦¨¬°¬q®aªº¤@­û¤F, §Æ±æ¤j®a¯à¥»µÛ¦¿´òºë¯«·ÓÅU¥L¡C",me->name(1)));
          }
          else
          {
            command("sigh "+me->query("id"));
            write(RANK_D->query_respect(me)+"§Aªº¤å¾Ç¯À¾i¤Ó²L¤F, ¤]³\\À³¸Ó¦h¥h«~À|®ÑÄy, "+
            "¤U¦¸¦³§â´¤¤F¦A¨Ó§ä§Ú§a...\n");
          }
          me->delete_temp("answer");
        }
        return 1;
}

