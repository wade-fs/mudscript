void hurt(object me, object victim, object weapon, int damage)
{
        int force;
        if( me->query("force_factor") > 0 && !me->query_temp("conti",1))
//if(random(500)<me->query_skill("force")+me->query_skill("six-fingers",1))
  if(random(100)>70)  {
          force = me->query_skill("sunforce");
          if(force > 150) force=150;
victim->receive_damage("kee",force);
          message_vision(sprintf(HIM + "$N六脈神劍詭異的氣勁鑽入$n體內﹐$n臉上突然一陣青白﹐看來已受了不小的內傷。\n" + NOR),me,victim);
          if(damage <=0 )
          COMBAT_D->report_status(victim);
          me->add("force",-force);
        }
}
void block(object me, object victim, object weapon, int damage)
{
        int force;
        if(damage > 40 && !me->query_temp("conti",1)&&random(100)>70)
        {
          force = (int)(me->query_skill("sunforce"));
          force = random(force/3);
          victim->apply_condition("blockade",5);
// random(me->query_skill("sunforce")+me->query_skill("six-fingers") )/20 );
          message_vision(sprintf(HIY + "$N六脈神劍暗藏一陽指手法﹐反手點中$n的膻中大穴。\n" + NOR),me,victim);
          victim->start_busy(1);
          COMBAT_D->report_status(victim);
        }
}
void conti(object me, object victim, object weapon, int damage)
{
        int i,time = 3;
if(me->query("force_factor") >= 10&&me->query("family/family_name") == "段家"&&random(100)>70)
        {
          if( me->query_temp("conti") == 0 )
          {
                 me->delete_temp("super");
            me->set_temp("conti",1);
      message_vision(sprintf("\n[1;33m$N忽然頓悟六脈神劍[1;5;36m氣遊百穴[0m、[1;5;36m連綿不絕[0m[1;33m的要訣, 劍氣自然而然的破體而出, 欲罷不能!![0m\n"),me);
              for(i=0;i<=time;i++)
              COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), TYPE_QUICK);
            me->delete_temp("conti");
          }
        }
            me->start_busy(random(1));
}

void sp1(object me, object victim, object weapon, int damage)
{
int i,vic_kee;
//vic_kee = victim->query("eff_kee")/30;
if(me->query("force") > 200 && me->query("force_factor") && me->query("env/六絕劍","yes"))
{
  for(i=1;i<=6;i++)
  {
    switch(i)
    {
     case 1:
message_vision(sprintf("$N領悟了" + HIW + "『少商劍』" + HIY + "『氣湧如山﹐席捲天下』" + NOR + "的真意﹐向$n當頭斬下!\n"),me,victim);
     break;
     case 2:
message_vision(sprintf("\n$N領悟了" + HIW + "『商陽劍』" + HIG + "『身形靈動﹐勢若流雲』" + NOR + "的真意﹐對$n四肢砍落!\n"),me,victim);
     break;
     case 3:
message_vision(sprintf("\n$N領悟了" + HIW + "『中衝劍』" + HIC + "『劍氣沖天﹐盈不可久』" + NOR + "的真意﹐往$n胸前疾刺!\n"),me,victim);
     break;
     case 4:
message_vision(sprintf("\n$N領悟了" + HIW + "『關衝劍』" + HIM + "『氣凝丹田﹐以靜制動』" + NOR + "的真意﹐鶩然間刺向$n!\n"),me,victim);
     break;
     case 5:
message_vision(sprintf("\n$N領悟了" + HIW + "『少衝劍』" + NOR + "" + CYN + "『應左則右﹐虛幻不定』" + NOR + "的真意﹐劍影包圍住$n!\n"),me,victim);
     break;
     case 6:
message_vision(sprintf("\n$N領悟了" + HIW + "『少澤劍』" + BLU + "『雲譎波詭﹐亦幻亦真』" + NOR + "的真意﹐劍氣疾射向$n!\n"),me,victim);
     break;
     }
//if(me->query_skill("sunforce")+me->query_skill("six-fingers") >random(180))
//     {
message_vision(sprintf(HIR + "$N確實命中$n要害，$n頓時血流滿地。\n" + NOR),me,victim);
          victim->receive_wound("kee",67);
          COMBAT_D->report_status(victim, 1);
          me->add("force",-20);
//      }
//       else
//      {
//message_vision(sprintf("結果$n迅速地避開這招。\n"),me,victim);
//      }
   }
message_vision(sprintf(HIW + "\n$N使力過度, 一時之間無力再戰!\n" + NOR),me,victim);
me->start_bsuy(1);
  }
}
void sp2(object me, object victim, object weapon, int damage)
{
        int six, force;
        six = me->query_skill("six-fingers");
        force = me->query_skill("sunforce");
if( random( force ) > random( six )&&!me->query_temp("conti",1))
        {
          message_vision(sprintf(HIG + "$N縱聲長嘯﹐雙手混元歸一中宮直入﹐無數道劍氣在$n身上對穿而過!!\n" + NOR),me,victim);
          victim->receive_damage("kee",six*3/2);
          victim->apply_condition("bleeding",random(six/20));
          COMBAT_D->report_status(victim);
        }
}

void sp3(object me, object victim, object weapon, int damage)
{
        int force;
        force = me->query_skill("sunforce");
        if( me->query("force_factor") >= 10 && victim->query_condition("blockade") && !me->query_temp("conti",1))
        {
          message_vision(sprintf(HIC + "$n先前內傷受到$N無形劍氣牽引﹐$n的傷勢更加重了!!\n" + NOR),me,victim);
          victim->receive_damage("kee",150);
              victim->start_busy(1);
          COMBAT_D->report_status(victim);
        }
}


mapping query_action(object me, object weapon)
{
        int level=(int)(me->query_skill("six-fingers",1));

        if ( level < 10 )
           return action [random(2)];
        else if ( level < 20 )
           return action [random(4)];
        else if ( level < 30 )
           return action [random(6)];
        else if ( level < 40 )
           return action [random(8)];
        else if ( level < 50 )
           return action [random(10)];
        else if ( level < 60 )
           return action [random(12)];
        else if ( level < 70 )
           return action [random(13)];
        else if ( level >= 70 && me->query_temp("super",1))
           return action [12];
        else if ( level <= 100 && me->query("marks/six_sp") ==1 && me->query("family/family_name") == "段家")
           return action [random(12)+2];
        else if ( level <= 100 && me->query("marks/six_sp")==2 && me->query("family/family_name") == "段家")
           return action [random(11)+4];
        else if ( level >= 100 && me->query("marks/six_sp")==3 && me->query("family/family_name") == "段家")
           return action [random(12)+4];
        else
           return action [random(13)];
}

int valid_learn(object me)
{
        if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
          return notify_fail("練六脈神劍還是要空手吧....\n");
        if(me->query_skill("force")*3<=me->query_skill("six-fingers",1))
          return notify_fail("你的基本內力技能不足, 無法練六脈神劍。\n");
        if(me->query_skill("literate")*3<=me->query_skill("six-fingers",1))
          return notify_fail("你的知識不足﹐無法體會六脈神劍裡﹐全身經脈運行之道的精要變化。\n");
        return 1;
}

int valid_enable(string usage)
{
      if(this_player()->query_skill("six-fingers",1) >= 45)
         {
            return (usage=="unarmed"||usage=="stabber")||(usage=="parry");
         }
          return (usage=="unarmed");
}

int practice_skill(object me)
{
        if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
          return notify_fail("練六脈神劍還是要空手吧....\n");
        if( (int)me->query("gin") < 5 )
          return notify_fail("你的精不夠﹐無法練習。\n");
        if( (int)me->query("kee") < 30 )
          return notify_fail("體力不夠囉,休息一下再繼續練吧.\n");
        if( (int)me->query("force") < 1 )
          return notify_fail("目前內力不足,休息一會兒再練吧.\n");
        me->receive_damage("gin", 5);
        me->receive_damage("kee", 30);
        me->add("force", -1);
        return 1;
}
string perform_action_file(string action)
{
        return CLASS_D("scholar")+"/six-fingers/"+action;
}
