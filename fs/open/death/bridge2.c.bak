// Room: /open/death/bridge2.c

inherit ROOM;

void create ()
{
  set ("short", "奈何橋上");
  set ("long", @LONG
著名的奈何橋，奈何橋上三聲無奈，早知如此，何必當初，善有善報
，惡有惡報，再往前頭去就進了地府了．你突然想起一生的殺戮，不禁一
身冷汗直流，難道真的報應臨頭了嗎！？隨著鬼門關的逼近，心裡越來越
恐懼，沒想到叱吒江湖多年的你也會有報應的一天，聽說一過奈何橋就回
不去了，真的無路可逃了嗎！？往橋下看去，烏黑的水流中帶著些許的腥
味，恐怕沒有人敢跳下去吧！？
LONG);

  set("exits", ([ /* sizeof() == 2 */
  "south" : __DIR__"bridge1",
  "north" : __DIR__"bridge3",
]));
  set("no_auc",1);
  set("item_desc", ([ /* sizeof() == 1 */
  "water" : "好黑的水喔！！為什麼有腥味！？哇！！原來是血水！！
",
]));
  set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/ghost1" : 1,
]));
  set("light_up", 1);
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_transmit", 2);

  setup();
}

int valid_leave(mixed me, string dir)
{
	if(me->query_temp("ask") > 5)
		return notify_fail("你還沒賭完，不可以走開！！\n");
	me->delete_temp("ask");
	return 1;
}

