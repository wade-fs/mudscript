int valid_leave(mixed me, string dir)
{
        int i;
        string room;

        if (dir == "south") {
                i = (int)me->query_temp("back_road");
                i = i + 1;
                if (i >= (random(5) + 5)) {
                    me->set_temp("back_road", 10);
                    return notify_fail("§A¯uªº¨º»ò·Q¦^®a¶Ü¡H  ¦n§a¡I¡I´N¦p§A©ÒÄ@¡A¤£¹L­n¥I¥X«Ü¤jªº¥N»ù³á¡I¡I\n·Q²M·¡¤F¤§«á¡A ¦pªGÁÙ¬O­n¦^¥hªº¸Ü´N©¹¤W­±¨«§a¡I¡I\n");
                } else {
                        me->set_temp("back_road",i);
                        return notify_fail("§AÁÙ·Q¦^®a¡H¶i¤F¦a©²´N¨S¦³¸ô¥i°h¤F¡I\n");
                }
        }
        else if (dir == "north") {
                me->delete_temp("back_road");
                return 1;
                }
        else if (dir == "up" || dir == "¤W­±")
        {
            if ( (int) me->query_temp("back_road") >= 10 )
            {
                end_death(me);
                me->delete_temp("back_road");
                me->reincarnate();
                if(!stringp(room = me->query("startroom")))
                    room = STARTROOM;
                me->move(room);
                message_vision(
                "¬ðµM¤Ñ¤¤­°¤U¤@¹Î²»¥ú¡A¥O¤HµLªk¥Î¦×²´ª½µø¡C\n¹L¤F¤@·|¨à¡A²»¥ú´²¥h¡A¤@¹D¤H¼v¥X²{¡A$N²×©ó±q³±¶¡°½¶]¦^¨Ó¤F¡C\n",me);
                return notify_fail("®¥ÁH§A¤S­«¦^¤H¥@¤F¡C\n");
            } else
                return notify_fail("·Q¦^¥h¡I¡H ¨S¨º»òÂ²³æ¡I¡I\n");
        }
        else
        return 1;
}

void auto_revive(object ob)
{
        end_death(ob);
        ob->reincarnate();
        ob->move(REVIVEROOM);
        tell_object(ob, "ÀFÃ¹¤ý¬Ý§A¤£²n°Õ¡I¡I°e§A¦^¤H¶¡¡I¡I\n");
}
//¼W¥[°O¿ýª±®aªº¦º¤`¡A¥H§K¨C¦¸³£¦³¤H»¡¬O²ö¦W¨ä§®ªº¦º¤F by bss
void start_death(object ob)
{
        string str="";
        object fighter;

        if(ob->query_temp("last_damage_from"))
        {
                fighter=ob->query_temp("last_damage_from");
                str=ob->query("name")+"³Q"+fighter->query("name")+"©Ò±þ¦b"+ctime(time())+"\n";
                write_file("/open/death/death_record", str);
        }
        if(ob->query("combat_exp"))
        ob->set("death/combat_exp", 1);
        ob->add("death/time", 1);
        ob->set("death/skill", 1);
        if( ob->query("max_force") || ob->query("max_mana") || ob->query("max_atman") )
        {
        if( ob->query("max_force") >= ob->query("max_mana")
        && ob->query("max_force") >= ob->query("max_atman") )
        ob->set("death/force", 1);
        else if( ob->query("max_mana") >= ob->query("max_force")
        && ob->query("max_mana") >= ob->query("max_atman") )
                ob->set("death/mana", 1);
        else
                ob->set("death/atman", 1);
        }
//      call_out("auto_revive", 300, ob);
}

