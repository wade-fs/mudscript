inherit ROOM;
#include <ansi.h>
void create ()
{
  set ("short", "Title 變更處");
  set ("long", @LONG
這裡是用來修改成經挑戰過試煉之塔的人們的封號
，只有武者可以進行更改，請輸入change title。
LONG);

  set("exits", ([ /* sizeof() == 1 */
  "south" : __DIR__"ticket",
]));

  setup();
}

void init()
{
add_action("do_change_title","change");
}

int do_change_title(string arg)
{
object me=this_player();
if(!arg||arg!="title")
return 0;
if(!me->query("quest/start_game_prize"))
{
tell_object(me,"火神舞說道：你又沒有改過title。\n");
return 1;
}
if(me->query("class")!="fighter")
{
tell_object(me,"火神舞：你不是武者...我不幫你改title。\n");
return 1;
}
else
{
me->delete("quest/start_game_prize");
me->set("title",HIY"玄天武尊"NOR);
tell_object(me,"稱號稱改成功。\n");
return 1;
}
}
