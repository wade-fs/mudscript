inherit ROOM;
#include <ansi.h>
void create()
{
set("short","試煉塔三十二樓");
set("long",@LONG

強大的氣壓籠罩住整個房間，一股極大的氣流在房間內四處流竄，
要是沒有良好的內力抵擋著，可能已經被氣壓給壓扁了，看來這裡
的對手必定比以往還要難對付。

LONG);
set("exits",([
"up":__DIR__"busy_room33",
"south":__DIR__"busy_room32",
]));
set("no_die_room",1);
set("light_up",1);
set("no_transmit",1);
set("no_auc", 1);
set("objects",([
__DIR__"obj/robot32":1,
]));
setup();
}
int valid_leave(object me,string dir)
{
if(dir=="up")
{
int check=me->query("quest/start_game");
if(check<33)
{
tell_object(me,HIR"系統：你的晶片資料不足以通往樓上。\n"NOR);
return 0;
}
{
message_vision(HIW"系統：讀取"+me->query("name")+"ソ晶片，通過。\n"NOR,me);
return 1;
}
}
if(dir=="south")
return 1;
}
