inherit ROOM;
#include <clog.fun>
#include <count-time.fun>

void create()
{
        set("short","殺塚");
        set("long",@LONG
地上舖滿著方正的石塊，每塊間隔的十分緊密，間隙小的連細砂
礫都無法置於其中，在平坦的石塊上，有一個方形直立的八角石碑佇
著，整個石碑大小與一個人同高，其碑面上字跡已經模糊掉了。

LONG);
        set_temp("waste_time",9999999);
        setup();
}

void init()
{
        add_action("do_pray","pray");
        add_action("do_start","start");
        add_action("do_finish","finish");
        add_action("do_count","count");
        add_action("do_lc","lc");
}

int do_lc(string i)
{
        object ob;

        if(!i)
                return 0;

        write(""+i+"\n");

        switch(i)
        {
                case "1":
                        ob=new("/open/fire-hole/npc/fire-dragon");
                        break;
                case "2":
                        ob=new("/open/mogi/castle/npc/fire-king");
                        break;
                case "3":
                        ob=new("/open/quests/snake/npc/master_snake");
                        break;
                case "4":
                        ob=new("/open/ghost-hole/npc/ghost-king");
                        break;
                case "5":
                        ob=new("/open/mon/npc/dance");
                        break;
                default:
                        break;
        }
        ob->set("gin",1);
        ob->set("kee",1);
        ob->set("sen",1);
        ob->move(this_object());
return 1;
}


int do_pray()
{
object me;
int r;
        me = this_player();
        r = 2;  
        write_log(me,"增加了"+r+"點內力值。");
        write_log(me,"獲得稱號");
                
return 1;
}

int do_start()
{
        start_time(this_player(),"test");
return 1;
}

int do_finish()
{
        finish_time(this_player(),"test");
return 1;
}

int do_count()
{
string arg;
        arg = count_time(this_player(),"test");
        write(arg+"\n");
return 1;
}
