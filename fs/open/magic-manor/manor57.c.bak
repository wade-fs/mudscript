#include <ansi.h>
inherit ROOM;

void create ()
{
	set ("short", HIB"封靈祭臺"NOR);
	set ("long", @LONG
豎立在這裏的是一個大型的祭台，歷經久遠的歲月，祭台已顯得
殘破，卻不失其形，四周已長滿了青苔和佈滿和蛛網，祭台上空無一
物，只有大小不同的凹痕，卻不知其作用為何。
LONG);

	set("no_auc", 1);
	set("no_transmit", 1);

	set("exits", ([ /* sizeof() == 3 */
	"south"	: __DIR__"manor56",
	]));

	set("objects", ([ /* sizeof() == 3 */
	__DIR__"ghost/obj/five-color" : 1,
	]));

	set("light_up", 1);
	set("outdoors", "/open/magic-manor");

	setup();
}

int start()
{
	object room = this_object();
	call_out("close",7200,room);
	return 1;
}

int close(object room)
{

	room = this_object();
	room->delete("no_reset");
	return 1;
}
