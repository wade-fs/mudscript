#include <room.h>
#include <ansi.h>
inherit ROOM;
void create ()
{
  set ("short", HIC"狂想空間小秘技天地"NOR);
  set ("long","這房間是介紹一些狂想的在玩時的一些小秘技!!
  提供給新玩家參考之用!!!
  秘技五：指令簡化
  狂想空間的系統會自動搜尋最有可能的指令....
  如你打surrender(投降的指令)..要打全名打完時也許\就被打死了...
  所以你可以只打surr 系統會自動幫你執行surrender的指令!!!!

  另外還有許\多練功\的秘技...及增加屬性的秘技..及謎..
  那要玩家自己去發掘!!!!!
\n");
  set("exits", ([
  "north" : __DIR__"newhand4-1",
  "south" : __DIR__"newhand",
               ]));
  set("light_up", 1);
  setup();
}

