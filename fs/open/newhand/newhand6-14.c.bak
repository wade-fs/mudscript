#include <room.h>
#include <ansi.h>
inherit ROOM;
void create ()
{
  set ("short", HIY"狂想空間歷史發展館"NOR);
        set( "long", "那時狂想空間便由中興及分站(Nkit)移至交大研究室中,正當我們在準備
發展FS及GFS時發生了一些問題..........
1.FS在交大的主機是借放在Acmesoft某一主管的交大實驗室中,由於我們沒有
注意,因此使FS佔用過多的頻寬,被他們的教授給限制了!!!!
2.GFS的成員分散全省各位,溝通聯繫不便,且重要的是有二位重要成員那時還
在服役。
3.ACME入伍了.....使我們跟Acmesoft溝通上出了點問題!!!!
4.在某天忘了,我先跟Wade討論,決定將Fs暫放到師大的主機上,請Wade先跟他
boss討論一下,另外在研究GFS的計畫.....
5.但是一直沒有消息,所以我就把FSLIB拿回雄專!!!放回原有的主機上!@!!!
6.但是原有的主機功能太低(DX-2-66)所以我拿了一塊P-133及32M請ANMY幫
FS換上主機....
7.那次是我最後一次跟Wade聯繫......
8.綜合起來,這次合作案應該是算失敗,真的是很可惜,另外我想我自己也該檢
討,沒有注意到FS所佔用的頻寬,還有我本來一直以後在交大的P2-350的主機至
少可以上三百人,但事實證明,最多上七十人網路頻寬就不夠用了!!!!!!
" );
  set("exits", ([
  "north" : __DIR__"newhand6-13",
  "south" : __DIR__"newhand6-15",
               ]));
  set("light_up", 1);
  setup();
}

