void heart_beat()
{
  object *enemy,me;
  int i;
  me = this_object();
  if( me->is_fighting() )
  {
    if( 50 > random(200) )
    {
      enemy = me->query_enemy();
      i=random(sizeof(enemy));
      if(environment(me) == environment(enemy[i]))
      if( random(10) > 7)
      {
       message_vision(HIR+"¦åÄQÅï¦R¥X¬õ¦âªº¬rÃú,´Â$Nªº¤è¦VÅ§±²¦Ó¨Ó!!!\n"+NOR,enemy[i]);
