int do_join()
        {
        if(this_player()->query("class"))
                return notify_fail("§A¤w¸g¥[¤J¨ä¥L¤u·|¤F¡C\n");
        if(this_player()->query("officer_class"))
                return notify_fail("±Ð¬Ó§N§Nªº»¡¹D¡G§A¦b¤¤­ì¤v·í¹L©x¤F¡A§Ú¸t¤õ±Ð¤£Åwªï§A!!\n");
        this_player()->set("class","prayer");
