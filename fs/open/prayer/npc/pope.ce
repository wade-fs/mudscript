¦U¦ì¸t¤õ±Ðªº§Ì¤l­Ì¡A\n
Åý§Ú­ÌÅwªï[32m" +this_player()->name()+"[33m¥[¤J§Ú[31m¸t¤õ±Ð[33m!![0m\n\n",users());
        return 1;
}
