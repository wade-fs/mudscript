inherit ROOM;

void create()
{
        set("short","屍骨道");
        set("long",@LONG
妳的腳下是由屍骨所堆積而成的道路，每一個骨頭的形狀，一看
就知道不是一般的人類骨架，妳蹲下身，仔細瞧瞧後，發現到每一個
骨頭上面都有不同的傷痕，有的是抓痕，有的是咬痕，有的是裂痕，
甚至於還有十分利落的刀痕，看來這裡可能是邪靈界的棄屍處，往南
望去，似乎有一個湖泊在不遠的南方，往北則是進入沙漠。
LONG);
        set("exits",([
"south":__DIR__"d-02",
]));
        set("objects",([
__DIR__"npc/wood-worm":1,
__DIR__"npc/mob1":2,
]));
        set("no_transmit",1);
        set("evil-area",1);
        setup();
}

