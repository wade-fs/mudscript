{
        if( ratio==100 ) return HIW "¬Ý°_¨Ó¥Rº¡¬¡¤O¡M¤@ÂI¤]¤£²Ö¡C" NOR;
        if( ratio > 95 ) return HIG "¦ü¥G¦³¨Ç¯h¾Î¡M¦ý¬O¤´µM¤Q¤À¦³¬¡¤O¡C" NOR;
        if( ratio > 90 ) return HIG "¬Ý°_¨Ó¥i¯à¦³¨Ç²Ö¤F¡C" NOR;
        if( ratio > 80 ) return GRN "°Ê§@¦ü¥G¶}©l¦³ÂI¤£¤ÓÆF¥ú¡M¦ý¬O¤´µM¦³±ø¤£¯¿¡C" NOR;
        if( ratio > 60 ) return HIY "®ð³Ý¼N¼N¡M¬Ý°_¨Óª¬ªp¨Ã¤£¤Ó¦n¡C" NOR;
        if( ratio > 40 ) return YEL "¦ü¥G¤Q¤À¯h¾Î¡M¬Ý¨Ó»Ý­n¦n¦n¥ð®§¤F¡C" NOR;
        if( ratio > 30 ) return HIR "¤w¸g¤@°ÆÀY­«¸}»´ªº¼Ò¼Ë¡M¥¿¦b«j¤O¤ä¼µµÛ¤£­Ë¤U¥h¡C" NOR;
        if( ratio > 20 ) return HIR "¬Ý°_¨Ó¤w¸g¤O¤£±q¤ß¤F¡C" NOR;
        if( ratio > 10 ) return RED "·nÀY®Ì¸£¡B¬n¬n±×±×¦a¯¸³£¯¸¤£Ã­¡M²´¬Ý´N­n­Ë¦b¦a¤W¡C" NOR;
        return                  RED "¤w¸g³´¤J¥b©ü°gª¬ºA¡MÀH®É³£¥i¯àºL­Ë·w¥h¡C" NOR;
