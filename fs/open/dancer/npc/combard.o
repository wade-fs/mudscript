string eff_status_msg(int ratio)
{
        if( ratio==100 ) return HIW "¬Ý°_¨Ó®ð¦å¥R¬Õ¡M¨Ã¨S¦³¨ü¶Ë¡C" NOR;
        if( ratio > 95 ) return HIG "¦ü¥G¨ü¤FÂI»´¶Ë¡M¤£¹L¥ú±q¥~ªí¬Ý¤£¤j¥X¨Ó¡C" NOR;
        if( ratio > 90 ) return HIG "¬Ý°_¨Ó¥i¯à¨ü¤FÂI»´¶Ë¡C" NOR;
        if( ratio > 80 ) return GRN "¨ü¤F´X³B¶Ë¡M¤£¹L¦ü¥G¨Ã¤£Ãª¨Æ¡C" NOR;
        if( ratio > 60 ) return HIY "¨ü¶Ë¤£»´¡M¬Ý°_¨Óª¬ªp¨Ã¤£¤Ó¦n¡C" NOR;
        if( ratio > 40 ) return YEL "®ð®§²Ê­«¡M°Ê§@¶}©l´²¶Ã¡M¬Ý¨Ó©Ò¨üªº¶ËµÛ¹ê¤£»´¡C" NOR;
        if( ratio > 30 ) return HIR "¤w¸g¶Ë²ª²Ö²Ö¡M¥¿¦b«j¤O¤ä¼µµÛ¤£­Ë¤U¥h¡C" NOR;
        if( ratio > 20 ) return HIR "¨ü¤F¬Û·í­«ªº¶Ë¡M¥u©È·|¦³¥Í©R¦MÀI¡C" NOR;
        if( ratio > 10 ) return RED "¶Ë­«¤§¤U¤w¸gÃø¥H¤ä¼µ¡M²´¬Ý´N­n­Ë¦b¦a¤W¡C" NOR;
        if( ratio > 5  ) return RED "¨ü¶Ë¹L­«¡M¤w¸g©a©a¤@®§¡M©R¦b¥¹¤i¤F¡C" NOR;
        return                  RED "¨ü¶Ë¹L­«¡M¤w¸g¦³¦p­·¤¤´ÝÀë¡MÀH®É³£¥i¯àÂ_®ð¡C" NOR;
}

