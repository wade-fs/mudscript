inherit ROOM;

#include "room.msg"
string random_road();

string *dirs = ({
    "north","south","east","west"
    });

void create ()
{
set ("short", "íL«Í¬}¤J¤f");
set ("long",(: query_long :));
set("no_transmit", 1);
set("no_scale",1);
set("objects",([
	__DIR__+"npc/linman":1
]));
set("exits", ([ /* sizeof() == 3 */
	"out"	: "/open/magic-manor/manor74",
]));
setup();
}
void reset()
{
  random_road();
  ::reset();
}
string random_road()
{
  object room;
  object prevroom;
  string to,from;
  prevroom = load_object(__DIR__+"room01.c");
  for(int i = 1 ;  i<= 10 ; i++)
  {
    room = load_object(sprintf(__DIR__+"room%02d",i));
    room->delete("exits");
  }
  for(int i = 2 ; i <= 10 ; i++)
  {
    room = load_object(sprintf(__DIR__+"room%02d",i));
    while(from = dirs[random(sizeof(dirs))]){
      if(!prevroom->query("exits/"+from)) break;
    }

    to = DIR_D->oppdir(from);
    room->set("exits/"+to , base_name(prevroom));
    for(int j = 0 ; j < sizeof(dirs) ;j++)
    {
      if(!prevroom->query("exits/"+dirs[j]))
      {
        prevroom->set("exits/"+dirs[j],sprintf(__DIR__+"room%02d",random(2)+1));
      }
    }
    prevroom->set("exits/"+from , base_name(room));
    prevroom = room;
  }
}
