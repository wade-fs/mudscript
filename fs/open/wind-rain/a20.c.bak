// by roger
inherit ROOM;
#include <ansi.h>
#include "wind-rain.h"
void create () {
set ("short",HIM"掩光天"NOR);
	set( "build", 58 );
set ("long", @LONG
忽入此室，光線彷彿都被吞噬了一般，清涼如夜，亦是不見五指， 
但覺陣陣異香撲鼻而來，撫人心神，這裡便是金風細雨樓一樓樓主
的三大守護天將之一所踞衛的掩光天，若要見到樓主，就必需先將
他打倒。
LONG);



  set("exits", ([
            "north"  : __DIR__"a2",
            "south"  : __DIR__"a9",
            "enter"  : __DIR__"a18",
                ]));

  set("objects", ([ 
  __DIR__"npc/shon-to" : 1,
                  ]));
       

        setup();
}

int valid_leave(object me, string dir)

{
        if(dir=="enter" && present("shon-to",environment(me)))
  {

message_vision(HIY"項拓說: 對不起, 樓主正在休息. \n"NOR,me);

return 0;
}
return 1;
}
