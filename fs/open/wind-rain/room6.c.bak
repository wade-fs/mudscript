");

       set("item_desc", ([
"poem" : "
                暖雨晴風初破凍, 柳眼梅腮, 己覺春心動

                酒意詩情誰與共. 淚融殘粉花鈿重.

                乍試夾衫金縷縫. 山枕斜攲, 枕損釵頭鳳

                獨抱濃愁無好夢, 夜闌猶剪燈花弄
  ",]));

        set("objects", ([ /* sizeof() == 1 */
