// Room: /u/w/whatup/poison_hole/hole01.c
#include <ansi.h>
inherit ROOM;

void create ()
{
  set ("short", "半山腰");
  set ("long", @LONG
遠方吹來陣陣的冷風，在這半山腰的高台上，你只見到石壁上有裂
縫(gate)。
LONG);
set("no_transmit", 1);
  set("outdoors", "/u/w");
  set("item_desc", ([ /* sizeof() == 1 */
  "gate" : "這裡是一個裂縫，裡面隱隱約約的透出一些光芒，可以試試灌注(crash)內
力來試著破壞他。
",
]));

  setup();
}
void init()
{
  add_action("do_crash","crash");
}
int do_crash(string arg)
{
  if(!arg) 
    return notify_fail("你想要用內力破壞什麼?\n");
  if(arg != "gate")
    return notify_fail("你想要用內力破壞什麼?\n");
  switch(this_player()->query("family/family_name"))
  {
    case "段家":
      case "銀針門":
      case "冥蠱魔教":
      break;
    default:
    return notify_fail("上面有奇怪的圖騰阻檔住你的內力！\n");
  }
  CHANNEL_D->do_channel(this_object(),"mud",HIR + this_player()->query("name") + "使用了全身的內力，破壞了牆上裂縫。\n"NOR);
  tell_object(this_player(),"你費盡全身的內力，終於衝破了裂縫，但一個腳軟就掉進洞裡了！\n");
  this_player()->set("force",0);
  this_player()->move(__DIR__"hole04");
  return 1;
}
