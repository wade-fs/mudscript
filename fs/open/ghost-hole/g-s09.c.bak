void init()
{
 object me = this_player();
 if(me->query("attribute") != "dark")
  {
    me->add("gin",-2*(me->query("max_gin"))/5);
    me->add("kee",-2*(me->query("max_kee"))/5);
    me->add("sen",-2*(me->query("max_sen"))/5);
  }
}
