int do_pray(string str)
{
  object me = this_player();
  string att =  me->query("attribute");
  if(att != "dark" && (!str || str != "statue"))
   {
          write("¬ðµM¶¡¡A¤Q·µÀFÃ¹¹³Å]¥ú¤j²±¡A¥R¨K¤§·¥ªº¦Ü¨¸§¯®ð¥Ñ¥|­±¤K¤è¤£Â_´é¦Ü¡A§AéãºÜ¤¸¯«©è§Ü¡C\n");
          me->unconcious();
          me->set("force",1);
          me->set("atman",1);
          me->set("mana",1);
          me->set("force_factor",0);
   }else{ 
         if(str)
         {
           if(str == "statue")
           {
            if(present("dark-spirit",me))
             {
              write("§A¨­¤Wªº¤ßÅ]·t¤§»î¬ðµM¤Æ§@£¸¹D¶Â¨~¡A¨³³t¦b¤Q·µÀFÃ¹¹³¶¡¹C¨«¡C\n");
              write("·t¤§»î¦ü¥G´Á«ÝµÛ©M§A§L¾¹ªº¿Ä¦X(blend dark)\n");
             }else write("£¸°}´o«ãªºÁn­µ¥Ñ¯«¹³¤W¶Ç¨Ó¡G¡y§A¨­¤W¨S¦³§Ú·Q­nªºªF¦è¡C¡z\n");
           }else{
                if(att == "dark")   write("°Ú§A¬O¦b«ô¤°»òªF¦è°Ú!?\n");
                }
         }else{
                if(!me->query_temp("pray_dark"))
                 {
                   write("¬ðµM¶¡¡A¤Q·µÀFÃ¹¹³Å]¥ú¤j²±¡A¥R¨K¤§·¥ªº¦Ü¨¸§¯®ð¤£Â_´é¤J§AÅé¤º¡A¥O§A¾Ô·N°ª©ù¡C\n");
