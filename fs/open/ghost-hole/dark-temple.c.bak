int do_blend(string str)
{
	object me,ob,ob1,ob2;
	me=this_player();
	ob=this_object();
	ob1=present("dark-spirit",me);
	ob2=present("dark-emblem",me);

	if( !str )	return 0;

	if( str == "dark" )
	{
	  if( !ob1 || !ob2 )
	  {
	  message_vision("¨S¦³¥ô¦ó¤ÏÀ³¡C\n",me);
	  }else{
	    if( ob2->query("specialitem") == 1 && ob1->query("spirit") == 1 )
	    {
	    message_vision("\n"+ob1->query("name")+BLU"©M"NOR+ob2->query("name")+BLU"·P¨ü¨ì¤@ªÑµL§Îªº¤O¶q½w½wªºÄÆ¯B¦bªÅ¤¤¡A\n¶Â¦âªº®ðÃúµ·µ·ªº±q"NOR+ob1->query("name")+BLU"©M"NOR+ob2->query("name")+BLU"´²µo¥X¨Ó¡C\n"NOR,me);
	    me->force_me("change unarmed");
	    me->start_busy(10);
	    call_out("compose1",5,me);
	    }else{
	    message_vision("¨S¦³¥ô¦ó¤ÏÀ³¡C\n",me);
	    }
	  }
	}else{
	message_vision("$N°µ¤F´X­Ó¸Þ²§ªº°Ê§@¡A«o¤£¨£¦³¤°»ò¤ÏÀ³¡C\n",me);
	}
	return 1;
}
int compose1(object me)
{
	object ob,ob1,ob2;
	me=this_player();
	ob=this_object();
	ob1=present("dark-spirit",me);
	ob2=present("dark-emblem",me);
	message_vision("\n"+ob1->query("name")+NOR+BLU"©M"NOR+ob2->query("name")+NOR+BLU"ÄÀ¥Xªº°}°}¶Â¦âÃú®ð¡AºCºCÅ¢·Ó"HIY"$N"NOR+BLU"¥|©P³ò¡A\n²´«eªºµø½u·U¨Ó·U©ü·t¡Aª½¦Ü§¹¥þ³Q±»¨S¡A¤@¤ù¶Â·t¡C\n"NOR,me);
	me->start_busy(10);
	call_out("compose2",5,me);
	return 1;
}
int compose2(object me)
{
	object ob,ob1,ob2,ob3,*aob;
	int i,j;
	me=this_player();
	ob=this_object();
	aob = all_inventory(me);
	i=sizeof(aob);
	ob1=present("dark-spirit",me);
	ob2=present("dark-emblem",me);

	for( j=i-1;j>=0;j-- )
	{
	  if( aob[j]->query("dev_wp") )
	  ob3 = aob[j];
	}
        write_file("/log/sky/powerup_claw",sprintf("%s(%s)¨Ï¥Î¤F%s©M%s¥[±j¤F%sªº«¬ºA©ó %s\n",me->name(1),me->query("id"),ob1->query("name"),ob2->query("name"),ob3->query("name"),ctime(time())));
	message_vision(BLU"\n¥u¨£"+ob3->query("name")+NOR+BLU"±N¥|©P³ò©Ò¦³ªº¶Â¦â®ðÃú¥þ³¡§l¦¬¦ÓÂàÅÜ¬°¤@­Ó§¹¥þªº§ÎºA¡I\n"NOR,me);
	me->set("weapon/dark-full",1);	//¿Ä¦X§¹²¦«á¡AªZ¾¹§e²{³Ì§¹¬üª¬ºAµ¹µ¹©wªºquery¡C
	message_vision(ob1->query("name")+NOR+BLU"©M"NOR+ob2->query("name")+NOR+BLU"©ÒÄ­ÂÃªº¯à¶q¦b³Q§l¦¬¬pºÉ«á¡A¤]¤Æ¬°µêµL®ø¥¢µLÂÜ¡C\n"NOR,me);
	destruct(ob1);
	destruct(ob2);
	me->delete_busy();
	return 1;
}
