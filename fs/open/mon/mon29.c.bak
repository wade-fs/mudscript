inherit ROOM;
#include <ansi.h>

void create ()
{
        set ("short", "山中小穴");
	set( "build", 54 );
        set ("long", @LONG
通道的盡頭，你來到了一處洞中小穴，但是卻看不到什麼猛獸在
這裏，但是依然可以聽到陣陣怪獸的嘶吼聲，不禁讓你想要在這邊尋
找一番，也許能夠再找到另外一條出路。
LONG);
        set("item_desc", ([ /* sizeof() == 1 */
        "button" : "這是一個暗藏在洞壁中的機關，你可以試著推(push)它。\n",
]));
        set("exits", ([ /* sizeof() == 4 */
        "south"      : __DIR__"mon53",
        "down"      : __DIR__"mine1",

]));
        setup();
}
void init()
{
        add_action("do_search", "search");
        add_action("do_push","push");
}
int do_search(string arg)
{
        object me=this_player();

        if(me->query_temp("mon/hole-search"))
        return 0;

        else{
        tell_object(me,"經過一番的搜尋，你在洞的一方發現了一個機關(button)。\n");
        me->set_temp("mon/hole-search",1);
        return 1;
        }
}
int do_push(string str)
{
        object me;
        me = this_player();
        if(me->query_temp("mon/hole-search")!=1)
        return 0;

        if(!str || str != "button")
        return notify_fail("你想推什麼？\n");
        else if(!query_temp("have_turn"))
        {
        message_vision("$N輕輕的把機關往前推送。\n",me);
        tell_room(this_object(),"你發現前方的山壁有一道門緩緩的打開。\n");
        set("exits/enter",__DIR__"mon30");
        set_temp("have_turn",1);
        me->delete_temp("mon/hole-search");
        remove_call_out("do_closed");
        call_out("do_closed",20);
        return 1;
        }
        
}

void do_closed()
{
        delete_temp("have_turn");
        delete("exits/enter");
        tell_room(this_object(),"機關感受不到壓力，石壁的門竟緩緩地自動關了起來。\n");
}


