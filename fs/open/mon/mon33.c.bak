inherit ROOM;
#include <ansi.h>

void create ()
{
        set ("short", "攀岩道");
        set ("long", @LONG
歷經了一番的辛勞，你終於登上了長白山上的攀岩道，在這一片
廣大的岩道上，無情的山風吹向你，讓你快站不住腳，溼冷的空氣濔
漫在空氣之中，你只能繼續的往上爬。
LONG);
        set("outdoors", "");
        set("exits", ([ /* sizeof() == 4 */
        "up"      : __DIR__"mon34",
]));
        setup();
}

void init()
{
  add_action ("do_climb","climb");
}

int do_climb (string str)
{
  object        me;

  if (str != "rock" && str != "岩石")
    return notify_fail("你爬呀爬呀......你爬了半天還是不幸重重的捽了下來.....\n");
  me = this_player();
  message_vision("$N運起十足的輕功\，一溜煙的就不見蹤影了。\n",me);
  me->move(__DIR__"mon28");
  tell_room(environment(me),
            sprintf ("%s運起十足的輕功\，身形立穩之時，已經溜下了攀岩道。\n", me->short()),
            me);
  return 1;
}

