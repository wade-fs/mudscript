
#include <room.h>
inherit ROOM;

void create()
{
  set("short", "北邊走廊");
  set("long", @LONG
你走到了屋子的內部,它不像鑣局,反而倒像一戶大戶人家,樹影陰陰,草木搖曳,這樣
    的院子,你可以從東邊的窗門看的一清二楚,向北方去是北廂,據說趙鼎天有個女兒
    長的十分漂亮.............
    你可以聽到陣陣吆喝聲從北邊傳來....
    東邊有一扇小紅門(door)。	
LONG
);

  set ("exits", ([
      "north": __DIR__"room7",
      "east": __DIR__"d_room0",
       "south": __DIR__"room0",
      ]) );
 	set("item_desc", ([     
  	"door": "一扇精巧的小紅門,可以從門中看到另一邊的景色.\n",
  	]));
  	setup();
        create_door("east","小紅門","west",DOOR_CLOSED);
}
