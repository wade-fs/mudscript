inherit ROOM;
#include <ansi.h>
#include "icestorm.c"
void create()
{
        set("short",HIC"南海"HIY"神殿"NOR);
        set ("long", @LONG
這裡是南海神殿，南海溫暖的水域，為中土提供豐富的漁獲，
一根高聳入天的石柱佇立在此，看來就是調節南海水量的支柱了，
然而這石柱散發著神聖不可侵犯的氣息，使人難以靠近。
LONG);
        set("exits", ([
	"north"	: __DIR__"room11",
	"northwest"	: __DIR__"room13",
        ]));
        set("light", 1);
	set("no_auc", 1);
	set("no_transmit",1);
	set("no_chome",1);
	set("no_quit",1);
	set("no_scale",1);
	set("objects", ([
           __DIR__"obj/stela7" : 1,
        ]));
        setup();
}
