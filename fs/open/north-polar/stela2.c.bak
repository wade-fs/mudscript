inherit ROOM;
#include <ansi.h>
#include "icestorm.c"
void create()
{
        set("short",HIC"鄱陽湖"HIY"神殿"NOR);
        set ("long", @LONG
這裡是鄱陽湖神殿，鄱陽湖為中土長江流域之中的第一大湖泊，
一根高聳入天的石柱佇立在此，看來就是調節鄱陽湖水量的支柱了，
然而這石柱散發著神聖不可侵犯的氣息，使人難以靠近。
LONG);
        set("exits", ([
	"northwest"	: __DIR__"room38",
    "east" : "/open/beggar/tower/door",
        ]));
        set("light", 1);
	set("no_auc", 1);
	set("no_transmit",1);
	set("no_chome",1);
	set("no_quit",1);
	set("no_scale",1);
	set("objects", ([
           __DIR__"obj/stela2" : 1,
        ]));
        setup();
}

int valid_leave( object me, string dir ) 
{
        if( dir=="east" && !userp(me) )  
                return 0;

       return ::valid_leave( me, dir );
}
