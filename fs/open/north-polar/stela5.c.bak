inherit ROOM;
#include <ansi.h>
#include "icestorm.c"
void create()
{
        set("short",HIC"印度洋"HIY"神殿"NOR);
        set ("long", @LONG
這裡是印度洋神殿，印度洋的濕暖空氣影響著中土西南的氣候，
一根高聳入天的石柱佇立在此，看來就是調節印度洋水量的支柱了，
然而這石柱散發著神聖不可侵犯的氣息，使人難以靠近。
LONG);
        set("exits", ([
	"southeast"	: __DIR__"room14",
        ]));
        set("light", 1);
	set("no_auc", 1);
	set("no_transmit",1);
	set("no_chome",1);
	set("no_quit",1);
	set("no_scale",1);
	set("objects", ([
           __DIR__"obj/stela5" : 1,
        ]));
        setup();
}
