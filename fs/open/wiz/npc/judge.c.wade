// judge.c

#include <login.h>
#include <ansi.h>

inherit NPC;

int in_ask, answer;

void create()
{
  set_name("冰判官", ({ "judge" }) );
  set("short", "專門對付笨蛋的審判官(judge)" );
  set("long",
    "這是一位審查玩家是否是笨蛋的審判官﹐你必須答對(answer)他三個問題才能\n"
    "脫離他的掌握。\n");

  set("gender", "男性");
  set("clan_kill",1);
  set("age", 40);

  set("str", 100);
  set("int", 100);
  set("cor", 100);
        set("gin", 999);
        set("kee", 999);
        set("sen", 999);

  set("no_kill",1);

  setup();

  in_ask = 0;
}

void init()
{
  string	id;

  ::init();
   this_player()->set_temp("old_startroom", this_player()->query("startroom"));
   this_player()->set("startroom", ROBOT_CHECK);

  id = this_player()->query("id");
  if( !query_heart_beat(this_object()) ) set_heart_beat(1);
  add_action("do_answer", "answer");
  add_action("no_dest","de");
  delete_temp("wrong/"+id);
  delete_temp("slow/"+id);
  this_player()->delete_temp("answer_right");
  add_action("no_tell", "tell");
  add_action("no_tell", "reply");
  add_action("no_tell", "whisper");
  add_action("no_tell", "shout");
  add_action("no_tell", "chat");
  add_action("no_tell", "rumor");
  add_action("no_action", "perform");
  add_action("no_action", "practice");
  add_action("no_action", "exert");
  add_action("no_action", "cast");
  add_action("no_action", "conjure");
  call_out("judge",1);
}

int no_action(string str){
        return notify_fail ("冰判官說道: 在這兒除了回答問題, 你還想幹嘛?\n");
}

int no_dest(string str){

if(this_player()->query("id")=="swy")
  {
    command("say 是的!! " +this_player()->query("id")+ "!! 我的主人!! 我馬上去死!!\n");
    message_vision("只見$N一聲令下, 冰判官切腹自殺了!!\n", this_player());
    this_object()->die();
  }
  else    
    write("你想消滅我冰判官!?乖乖回答問題吧!!\n");
  return 1;
}

int no_tell(string str){
        write("想搬救兵!?門兒都沒有!!\n");
        return 1;
}

void judge()
{
  object	ob, *inv;
  int a, b, c, d;
  string oper;
  
  remove_call_out("judge");
  remove_call_out("say_answer");
  if (in_ask)
    command("say 有人來了, 我們重新出題吧!");

  inv = all_inventory(this_object());
  for (a = 0; a<sizeof(inv); a++)
    if (userp(inv[a]))
      inv[a]->delete_temp("answer_right");
  in_ask = 0;
  a = random(100) + 1;
  b = random(100) + 1;
  switch(random(5)) {
    case 0: 
      answer = a + b;
      oper = chinese_number(a) + "加上" + chinese_number(b)+ "等於多少﹖";
      break;
    case 1: 
      answer = a - b;
      oper = chinese_number(a) + "減去" + chinese_number(b)+ "等於多少﹖";
      break;
    case 2: 
      if( a * b < 200 ) {
        answer = a * b;
        oper = chinese_number(a) + "乘上" + chinese_number(b)+ "等於多少﹖";
      } else {
        answer = (a * b) % 10;
        oper = chinese_number(a) + "乘上" + chinese_number(b)+ "﹐個位數等於多少﹖";
      }
      break;
    case 3: 
      answer = a % b;
      oper = chinese_number(a) + "除以" + chinese_number(b)+ "餘於多少﹖";
      break;
    case 4:
      oper = chinese_number(a) + "和" + chinese_number(b)+ "的最大公因數是多少﹖";
      if( b < a ) { c = b; b = a; a = c; }
      while( a > 1 && b%a > 1 ) {
        c = a;
        a = b%a;
        b = c;
      }
      answer = b%a == 1 ? 1 : a;
      break;
    case 5:
      d = a*b; 
      oper = chinese_number(a) + "和" + chinese_number(b)+ "的最小公倍數是多少?";
      if( b < a ) { c = b; b = a; a = c; }
      while( a > 1 && b%a > 1 ) {
        c = a;
        a = b%a;
        b = c;
      }
      answer = b%a == 1 ? d : d/a;
      break;
  }
  command("say " + oper + "﹐請在二十秒內作答(answer)。");
  in_ask = 1;
  call_out("say_answer", 20);
}

void say_answer()
{
  int		i;
  object	me, *inv, ob;
  string	id, name, ans;

  in_ask = 0;
  me=this_object();
  ans = chinese_number(answer);
  if (environment()) {
    inv = all_inventory(environment());
    for(i=0; i<sizeof(inv); i++) {
      ob = inv[i];
      id = ob->query("id");
      name = ob->name();
      if (!userp(ob) && ob != me) {
	destruct(ob);
	continue;
      }
      // 答對就不必檢查了
      if (ob->query_temp("answer_right")) {
	ob->delete_temp("answer_right");
        continue;
      }
      // 剩下的就是答錯的
      tell_object (ob, "冰判官說道: 這麼簡單都不會﹖答案等於"+ ans + "。\n");
      if(userp(ob) && !wizardp(ob)) {
	command ("say "+name+", 你反應太慢了喔!! 給我小心一點!!");
        add_temp("slow/" + id, 1);
        if (query_temp("slow/" + id) > 10) {
          command("say " + name + ", 你再發呆啊!! 再遲鈍啊!! 給我去死吧!!");
          ob->delete("env/immortal");
          delete_temp("slow/" + id);
          delete_temp("wrong/" + id);
          ob->command("quit");
        }
      }
    }
  }
  inv = all_inventory(environment());
  if (sizeof(inv))
    call_out("judge", 1);
}

int do_answer(string arg)
{
  string	s, myid, myname, id, home_path;
  object	me, *inv, ob, who;
  int		ans, i;

  if( !in_ask ) return notify_fail("你必須等下一題。\n");
  notify_fail("請你回答一個數字。\n");
  if( !arg ) return 0;

  who = this_player();
  myid = who->query("id");
  myname = who->name();
  me=this_object();

  if (who->query_temp("answer_right")) {
    tell_object (who, "冰判官說道: 你已經答對了, 不必再作答!\n");
    return 1;
  }
  tell_object (who, CYN "你答道﹕" + arg + "\n" NOR);
  
  if( sscanf(arg, "%d", ans)==1 ) {
    if( ans==answer ) {
      who->add_temp("robot_check", 1);
      command("say "+myname+"答對了﹗");
      command("pat " + myid);
      delete_temp("wrong/" + myid);
      
      if( who->query_temp("robot_check") >= 3 ) {
        command("say 很好﹐"+ myname + ", 你看起來不像笨蛋﹐你可以回家了。\n");
        if( stringp(s = who->query_temp("old_startroom")) )
          who->set("startroom", s);
        who->delete_temp("robot_check");
        delete_temp("wrong/" + myid);
        delete_temp("slow/" + myid);
        if ( file_size(home_path=user_path(geteuid(who)) + "workroom.c") > 0 )
	who->move(STARTROOM);
        else {
          if( stringp(s = who->query_temp("old_location")) )
            who->move(s);
          else
            who->move(STARTROOM);
        }
      }
      who->set_temp("answer_right",1);
    }
    else {
      command("say "+myname+"答錯了﹗");
      add_temp("wrong/" + myid, 1);
      if( query_temp("wrong/" + myid) > 10 ) {
        command("say " + myname + ", 你再給我亂猜啊﹐笨蛋!! 去死吧。\n");
        who->receive_damage("kee", 100, me);
        who->delete("env/immortal");
        delete_temp("slow/" + myid);
        delete_temp("wrong/" + myid);
        who->command("quit");
      }
    }
  }
  else return 0;
  return 1;
}
void die()
{

        object ob, ob1, ob2, ob3, ob4, ob5, ob6, ob7;
        if( !ob = query_temp("last_damage_from") )
                ob = this_player(1);

        if( !ob ) return;
       write(HIW"冰判官冷笑道：「連我你也敢殺。」\n"NOR);
       tell_object(users(),"【"HIC"閒聊"NOR"】"HIC"冰判官(judge)說道: "HIC+ob->query("name")+HIC"遭受"HIW"天譴"HIC"，從這個世界上消失了。\n"NOR);     
          ob->set("last_on", time());
          ob->set("last_from", query_ip_name(ob));
          ob->set_temp("last_damage_from", ob);
          ob -> die();

        destruct(this_object());
}
