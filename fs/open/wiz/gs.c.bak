#include <room.h>

inherit ROOM;

void create ()
{
  set ("short", "諸神傳說");
  set ("long", @LONG
中國古代的諸位天神：
        有巢氐、神農氐、伏羲氐、女媧氐、無名氐
  分別掌管居住、食物、命運、希望、？，祂們共同創造了這世界，在五位天神的
努力下，人們正欣欣向榮，國泰民安。然而，由於無名氐與其他四位天神的理念不
合，在一場鬥爭中，無名氐黯然離開了天界，並把北方天界打破了一塊，天神平時
的實驗失敗品--貪、瞋、痴、慢、疑--紛紛趁機逃出天界，成了為患世間的五毒陰
魔，雖然在女媧氐極力補救之下，天界被她以七塊彩石配天一神水煮沸後補起來，
然而，女媧氐一直擔心著無名氐，在她煉石過程中，忘了一樣--無極仙乳，因此七
塊彩石並沒有完全水乳交融，北方成了五毒陰魔聚積之處。
  傷心的女媧氐從此無心人間事，世界陷入一片混亂。有巢氐、神農氐、伏羲氐將
一切罪過推在無名氐上，並矢言將無名氐徹底消滅；就在三位天神遍尋不著無名氐
的同時，北方有個傳言，無名氐集合了五毒陰魔，並教他們各種神術，但是至此傳

言傳出後，卻沒有人真正看無名氐。
  有巢氐、神農氐、伏羲氐不容北方陰魔肆虐，率領五軍（十天將、五百牙將、十
萬天兵）--分前軍、中軍、後軍、左軍、右軍--夾擊五毒陰魔，卻慘敗負傷逃回天
界，從此世間進入黑暗期。
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "down" : "/open/common/room/inn",
]));

  set("no_clean_up", 0);


  setup();
  call_other("/obj/board/gods_b","???");
}
