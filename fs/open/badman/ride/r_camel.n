}

int do_descend()
{
  object me;
  string *name;
  me=this_player();
  if (!me->query_temp("is_riding"))
  return notify_fail("§A¨SÃMªF¦è¡A·F¹À¤U¨Ó¡H\n");
  message_vision("[1;37m$N¤@­ÓÂà¨­¡A«K¤wÀ³Án¸¨¦a¡A¦n¦n¦a¯¸¦b¦a¤W¡C[0m\n",me);
  me->delete_temp("is_riding");
  me->delete_temp("apply/name",name);
  move(environment(me));
  me->set_heart_beat(0);

  return 1;
}

int do_wall()
{
  object me,who;
  string *name;
  int dodge,camel;
  //·s¼Wtime --by kalin /2003/01/15
  int times = (this_player()->query("combat_exp")/500000+10);
  who=this_player();
  dodge=((who->query_skill("riding",1)+who->query_skill("parry",1))/2);
  camel=(who->query("marks/h_camel"));
  me=query_leader();
  who->add("marks/h_camel",random(3));
  if (!me)
  return notify_fail("³oÀd¾m¤£·í§A¬O¥D¤H¡AÁÙ¬OÃMÃM¬Ý§a¡I\n");
  if (who->query_temp("marks/wall",1))
  return notify_fail("§A«e­±¤w¸g¦³¹D¨FÀð¤F¡I\n");
  if (random(200)>(who->query_skill("riding",1)))
  return notify_fail("[1;37mÀd¾m¤£Å¥§Aªº«ü´§¡A¤£À°§A¿v°_¨FÀð¡I[0m\n");
  if (random(500) > camel)
  return notify_fail("[1;35m¬Ý¨Ó§A©MÀd¾mªº·P±¡¤£°÷¦n¡A¨e¤£²z§A¡C[0m\n");
 message_vision("[33m"+me->query("name")+"§¤¤UÀd¾m©¿µMÂù²´¤@¸C¡A¥|¸}¤O½ñ¦a­±¡A\n
¹Ð¨Fº¡¤Ñ­¸»R¡A"+who->query("name")+"¨­«e²{°_¤@¹D¨FÀð¡I[0m\n",who);
  who->add_temp("apply/defense",dodge);
  who->set_temp("marks/wall",1);
//  call_out("remove_effect",10,who); <--­ì¥»ªºtime
  call_out("remove_effect",times,who);  //2003/01/15 ­×§ï --by kalin
  return 1;
}

void remove_effect()
{
  object me,who;
  string *name;
  int dodge;
  who=this_player();
  me=query_leader();
  dodge=((who->query_skill("riding",1)+who->query_skill("parry",1))/2);
  message_vision("[1;37mÅFªº¤@Án¡AÅ÷¥ß¦b"+me->query("name")+"«eªº¨FÀð¤w®ø¥¢¡I[0m\n",who);
  who->add_temp("apply/defense",-dodge);
  who->delete_temp("marks/wall");
}

int heal_up()
{
  object *enemy,who,user;
  int i,dodge;
        user = query_leader();
  who = this_player();
  if(!user) return 1;
  if( user->is_fighting() )
  {
   user->add("marks/h_camel",random(3));
   if (random(120) < (user->query_skill("riding",1)))
   {
    enemy=user->query_enemy();
    i=random(sizeof(enemy));
    message_vision("[1;33m"+user->query("name")+"®y¤UÀd¾m¬ðµM±i¶}¼L¤Ú¡A\n
¥H¨³¹p¤£¤Î±»¦Õ¤§¶Õ¦V$n¦R¤F´X¤f¤f¤ô¡I$nÀþ¶¡¿ù´j¤£¤w¡AµLªk¦Û¤v¡I[0m\n",who,enemy[i]);
    enemy[i]->start_busy(2);
   }
  }
  return ::heal_up() + 1;
}
