int do_runaway()
{
  object me,wolf,target;
  string *name;
  me = this_player();
  wolf = this_object();
  target = me->query_enemy();
  if(!query_leader())
  return notify_fail("§A¬O³oÀd¾mªº¥D¤H¶Ü¡H\n");

  message_vision("[1;33mÀd¾m¨Ä¨Ä¦aÅ¥§Aªº¸Ü¡A¦^®a¥h¤F¡C[0m\n",me);
  me->delete_temp("is_riding");
  me->delete_temp("apply/name",name);
  me->delete_temp("marks/have_wolf");
  destruct(wolf);
  return 1;
}

int do_ascend()
{
  object me,wolf,target;
  me = this_player();
  wolf = this_object();
  target = me->query_enemy();
  if(wolf->query("horse")!=1)
  return notify_fail("§A­nÃM³oªF¦è¤£¦p¥h§²°|¡I\n");
  if(me->query("class")!="bandit")
  return notify_fail("³o°Êª«¤£¬O§A¥i¥H§¤ªº¡I\n");
  if (me->query("combat_exp") < 1200000)
  return notify_fail("§Aªº¦¿´ò¾ú½m¬Ý¨Ó¤£¯àÀ³¥I¦bÀd¾m¤Wªºª¬ªp¡C\n");
  if (me->query_skill("riding",1) < 1 )
  return notify_fail("§AÁÙ¤£ª¾¹DÃM³Nªº°ò¥»¡A­n«ç»òÃM¡H\n");
  if(me->query_temp("is_riding"))
  return notify_fail("§A¥¿¦bÃMµÛ©O¡I\n");
  message_vision("[1;33m$N¨­¤l¤@Âà¡AÂù¸}¤@½ñ¡AÀþ¶¡«K¦w§¤¦b¾m®p¤§¤W¡I[0m\n",me);
  wolf->set_leader(me);
me->add_temp("apply/name",({ me->name()+"¡]¥¿ÃMµÛ"+this_object()->name()+"¡^"}));
  me->set_temp("is_riding", 1);
