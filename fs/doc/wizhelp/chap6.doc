int free_ya(string str)
{
  object ob,ob1;
  ob=this_player();
  if(!present("ya",environment(ob)))       //me¬O¥Nªí¦Û¤v©Îª±®a ob¥Nªíª«¥ó®@
    return notify_fail("¤H¥h¼ÓªÅ¤F¡A§AÁÙ©ñ¤°»ò¡C\n");
  if( str!="ya")
    return notify_fail("§A­nÄÀ©ñ½Ö§r¡C\n");
  if( ob->query("force") > 1500)
  {
  message_vision(HIW"$N¹B°_¥þ¨­¤º¤O§èÂ_"HIC"´H¦BÅKÁå"HIW".........\n"NOR,ob);
ob->set("get_head",1);
  write("\n");
     ob1=present("ya",this_object());
  destruct(ob1);
  call_out("msg1",3,ob);
  return 1;
  }
  else
  {
   message_vision(HIW"$N¹B°_¤º¤O·Q­n§èÂ_"HIC"´H¦BÅKÁå"NOR"¡A¥Ñ©ó¤º¤O¤£¨¬³QÅKÁå¤Wªº´H®ð©Ò«I!!\n"NOR,ob);
   ob->add("kee",-150);
   return 0;
  }
}
