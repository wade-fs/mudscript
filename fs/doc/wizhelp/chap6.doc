int free_ya(string str)
{
  object ob,ob1;
  ob=this_player();
  if(!present("ya",environment(ob)))       //meONۤvΪa obN@
    return notify_fail("HhӪŤFAA٩񤰻C\n");
  if( str!="ya")
    return notify_fail("An֧rC\n");
  if( ob->query("force") > 1500)
  {
  message_vision(HIW + "$NB_O_" + HIC + "HBK" + HIW + ".........\n" + NOR,ob);
ob->set("get_head",1);
  write("\n");
     ob1=present("ya",this_object());
  destruct(ob1);
  call_out("msg1",3,ob);
  return 1;
  }
  else
  {
   message_vision(HIW + "$NB_OQn_" + HIC + "HBK" + NOR + "Aѩ󤺤OQKWHҫI!!\n" + NOR,ob);
   ob->add("kee",-150);
   return 0;
  }
}
