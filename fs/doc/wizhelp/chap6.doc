int snop_array(string arg)
{
     object ob,me;
     me=this_player();          //Nۤv
     if(me->query("id") != "chan")
       return notify_fail("uj~ťC\n");
     if( !arg )
      {
       if( objectp(ob = query_snooping(me)) ) //obNa
         write("A{bbť" + ob->query("name") + "Ҧ쪺TC\n");
         return 1;
      }
   if( arg=="none" )
       {
   if( objectp(ob = query_snooping(me)))
       write("Ať"+ob->query("name")+"Ҧ쪺TC\n");
       snoop(me);
       return 1;
       }
       ob = find_player(arg);

   if (!ob) ob = find_object(arg);
if(!ob)
return notify_fail("SoӤHC\n");
if (ob->query("id") == "chan"  )
  {
   message_vision(HIR + "ѤWǤUqn!!!MQťj!!!ha\n" + NOR,this_player());
   message_vision(HIC + "@DpgV$NghiȪu\n" + NOR,this_player());
   this_player()->set("kee",-100);
   return 1;
  }
   if( me==ob ) return notify_fail("Х snop none ѰťC\n");
     snoop(me, ob);
     return 1;
}
