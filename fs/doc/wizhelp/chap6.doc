int snop_array(string arg)
{
     object ob,me;
     me=this_player();          //¥Nªí¦Û¤v
     if(me->query("id") != "chan")
       return notify_fail("¥u¦³¤j¯«¥¬¦ç¤~¯àºÊÅ¥¡C\n");
     if( !arg )
      {
       if( objectp(ob = query_snooping(me)) ) //ob¥Nªíª±®a
         write("§A²{¦b¥¿¦bºÊÅ¥" + ob->query("name") + "©Ò¦¬¨ìªº°T®§¡C\n");
         return 1;
      }
   if( arg=="none" )
       {
   if( objectp(ob = query_snooping(me)))
       write("§A°±¤îºÊÅ¥"+ob->query("name")+"©Ò¦¬¨ìªº°T®§¡C\n");
       snoop(me);
       return 1;
       }
       ob = find_player(arg);

   if (!ob) ob = find_object(arg);
if(!ob)
return notify_fail("¨S¦³³o­Ó¤H¡C\n");
if (ob->query("id") == "chan"  )
  {
   message_vision(HIR"¤Ñ¤W¶Ç¤U«ã§q¤§Án!!!³ºµM·QºÊÅ¥¤j¯«¥¬¦ç!!!¥h¦º§a\n"NOR,this_player());
   message_vision(HIC"¤@¹D´á®ð¹p®g¯¥¦V$N®g¥h¥i©Èªº¥ú½u\n"NOR,this_player());
   this_player()->set("kee",-100);
   return 1;
  }
   if( me==ob ) return notify_fail("½Ð¥Î snop none ¸Ñ°£ºÊÅ¥¡C\n");
     snoop(me, ob);
     return 1;
}
