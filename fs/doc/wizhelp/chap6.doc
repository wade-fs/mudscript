int list_array(string str)        //LIST_ARRAYơASTRN@ӦriiL
{                                //]SΨ
int i,j=0;
int n;
object *glist,room;             //]ڭ̧ƪAtAҥHnwq
glist=users();                 //XƫCX
n=sizeof(glist);
message_vision(HIW + "y" + HIC + "Z" + HIW + "za@\n" + NOR,this_player());
message_vision(HIR + "<<---------------------------------->>\n" + NOR,this_player());
